# Não substitua seu .env existente: incorpore apenas as variáveis necessárias.
APP_ENV=development
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=120
EMBEDDING_MODEL=gemini-embedding-001
MAX_UPLOAD_BYTES=10485760
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llmops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=llmops
POSTGRES_PORT=5432
FRONTEND_PORT=8080
CACHE_TTL_SECONDS=3600
RAG_TOP_K=5
RAG_MAX_CHUNKS=200
RATE_LIMIT_PER_MINUTE=30
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]
# Em produção: APP_ENV=production e chaves aleatórias distintas com pelo menos 24 caracteres.
# API_TOKENS={"ana":"CHAVE_ALEATORIA_DE_PELO_MENOS_24_CARACTERES"}
API_TOKENS={}
GRAFANA_ADMIN_PASSWORD=change-me-local
