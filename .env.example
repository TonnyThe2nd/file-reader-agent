# Não substitua seu .env existente: incorpore apenas as variáveis necessárias.
APP_ENV=development
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_TOKENS=4096
OLLAMA_MAX_CONTEXT_CHARS=24000
MAX_UPLOAD_BYTES=10485760
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llmops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=llmops
POSTGRES_PORT=5432
FRONTEND_PORT=8080
CACHE_TTL_SECONDS=3600
RAG_TOP_K=5
RAG_MAX_CHUNKS=200
RATE_LIMIT_PER_MINUTE=30
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]
# Em produção: APP_ENV=production e chaves aleatórias distintas com pelo menos 24 caracteres.
# API_TOKENS={"ana":"CHAVE_ALEATORIA_DE_PELO_MENOS_24_CARACTERES"}
API_TOKENS={}
GRAFANA_ADMIN_PASSWORD=change-me-local
